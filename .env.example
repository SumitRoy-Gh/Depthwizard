# DepthWizard Environment Variables Example
# Copy this file to .env in the project root or adjust settings for your environment.

# ==============================================================================
# OpenTopography API Configuration
# ==============================================================================
# OpenTopography API Key used by dem_fetcher.py to download coarse DEM tiles (Copernicus GLO-30 / SRTM)
# Register for free at: https://portal.opentopography.org/myopentopo
OPENTOPOGRAPHY_API_KEY=your_opentopography_api_key_here

