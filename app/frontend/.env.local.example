# DepthWizard — frontend environment
# Copy to .env.local and adjust.

# Backend base URL (FastAPI service)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# "true" (default) → deterministic mock backend, sample tiles enabled
# "false"          → hit the real backend at NEXT_PUBLIC_API_BASE_URL
NEXT_PUBLIC_DEMO_MODE=true
