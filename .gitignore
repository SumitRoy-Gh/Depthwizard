# ==========================================
# DepthWizard (SIH175) Git Ignore Rules
# Tailored specifically for workspace structure
# ==========================================
# Local secrets and environment overrides
.env
.env.*
!.env.example
app/frontend/.env.local
app/frontend/.env.*.local
!app/frontend/.env.local.example

# Python environments, caches, and build output
.venv/
env/
venv/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
build/
dist/
*.egg-info/

# # JavaScript dependencies and Next.js output
# app/frontend/node_modules/
# app/frontend/.next/
# app/frontend/out/
# app/frontend/tsconfig.tsbuildinfo
# app/frontend/next-env.d.ts
# app/frontend/*.log
# app/frontend/AGENTS.md
# app/frontend/CLAUDE.md

# Heavy runtime assets: copy these separately or use Git LFS/object storage
models/
dataset/
data/
*.tif
*.tiff
*.geotiff
!/area2_imagery.tif
*.tfw
*.prj
*.pt
*.pth
*.ckpt
*.onnx
*.safetensors
stats.json

# Generated logs and experiment output
*.log
runs/
logs/
wandb/
.tensorboard/

# Archives and generated reports
*.zip
*.pdf

# OS and IDE metadata
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*.env
