# ==========================================
# DepthWizard (SIH175) Git Ignore Rules
# Tailored specifically for workspace structure
# ==========================================

# 1. Virtual Environments
.venv/
env/
venv/

# 2. Python Caches & Build Artifacts
__pycache__/
preprocessing/__pycache__/
preprocessing/ingest/__pycache__/
preprocessing/pipelines/__pycache__/
preprocessing/stages/__pycache__/
preprocessing/tests/__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
build/
dist/
*.egg-info/

# 3. Data Directories & Heavy Raster Files
# Ignore all raw, synthetic, and intermediate data files
data/raw/
data/synthetic/
data/synthetic_bad_gsd/
data/processed/
data/patches/
sample.tif

# Ignore all standalone geospatial raster binary formats
*.tif
*.tiff
*.geotiff
*.tfw
*.prj
*.png.aux.xml

# 4. Model Checkpoints & Statistics
*.pt
*.pth
*.ckpt
*.onnx
*.safetensors
weights/
checkpoints/
stats.json

# 5. Logs & Experiment Outputs
*.log
runs/
logs/
wandb/
.tensorboard/

# 6. OS & IDE Metadata
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# 7. Frontend (Next.js)
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/.env.local
frontend/.env*.local
frontend/*.log
